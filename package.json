{
  "name": "warsworld",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^25.0.0"
  },
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:destroy": "docker compose down --volumes --remove-orphans",
    "prisma:push": "prisma db push",
    "prisma:seed": "prisma db seed",
    "prisma:reset": "prisma migrate reset",
    "prisma:generate-once": "prisma generate",
    "prisma:generate-watch": "prisma generate --watch",
    "prisma:studio": "prisma studio",
    "dev:wss": "cross-env PORT=3001 tsx watch src/server/main-wss-development.ts --tsconfig tsconfig.server.json",
    "dev:next": "next dev",
    "dev": "npm run prisma:push && concurrently \"npm:dev:*\"",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint": "npm run lint:prettier && npm run lint:eslint",
    "lint:fix": "npm run lint:prettier:fix && npm run lint:eslint:fix",
    "build:next": "cross-env NODE_ENV=production next build",
    "build:server": "node bundleServer.mjs",
    "build": "concurrently \"npm:build:*\"",
    "start:next": "next start",
    "start:server": "cross-env NODE_ENV=production \"npm run prisma:push &&  node dist/server/main-production.mjs\"",
    "start": "concurrently \\\"npm:start:*\\\"\"",
    "redundant-code": "npx jscpd --ignore node_modules,dist,public,.next --reporters consoleFull .",
    "update-depencencies": "npx npm-check-updates -i",
    "fix-paths": "fix-esm-import-path  dist ",
    "install-utils": "npm install $(jq -r '.utilsDependencies | to_entries | .[] | \"\\(.key)@\\(.value)\"' package.json)"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "prettier": {
    "singleQuote": false,
    "endOfLine": "auto",
    "printWidth": 100
  },
  "dependencies": {
    "@auth/core": "^0.24.0",
    "@headlessui/react": "^1.7.18",
    "@prisma/client": "^5.8.1",
    "@react-hook/window-size": "^3.1.1",
    "@tanstack/react-query": "^4.36.1",
    "@tanstack/react-table": "^8.11.7",
    "@trpc/client": "^10.45.0",
    "@trpc/next": "^10.45.0",
    "@trpc/server": "^10.45.0",
    "bcrypt": "^5.1.1",
    "esbuild": "^0.28.0",
    "fix-esm-import-path": "^1.10.3",
    "gray-matter": "^4.0.3",
    "next": "^14.1.0",
    "next-auth": "^4.24.5",
    "pixi.js": "^7.4.0",
    "prisma-json-types-generator": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "sass": "^1.99.0",
    "sharp": "^0.34.5",
    "superjson": "^2.2.6",
    "uuid": "^14.0.0",
    "ws": "^8.20.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.0",
    "@stylistic/eslint-plugin-ts": "^1.5.4",
    "@types/bcrypt": "^5.0.2",
    "@types/eslint": "^9.6.1",
    "@types/node": "^20.11.10",
    "@types/react": "^19.2.14",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-next": "^0.0.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.13",
    "prisma": "^5.8.1",
    "resolve-tspaths": "^0.8.23",
    "tailwindcss": "^3.4.1",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "utilsDependencies": {
    "sharp": "^0.33.2",
    "yargs": "^17.7.2"
  }
}