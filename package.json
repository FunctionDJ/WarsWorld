{
  "name": "warsworld",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^25.0.0"
  },
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:destroy": "docker compose down --volumes --remove-orphans",
    "prisma:push": "prisma db push",
    "prisma:seed": "prisma db seed",
    "prisma:reset": "prisma migrate reset",
    "prisma:generate-once": "prisma generate",
    "prisma:generate-watch": "prisma generate --watch",
    "prisma:studio": "prisma studio",
    "dev:wss": "cross-env PORT=3001 bun --watch src/server/main-wss-development.ts --tsconfig tsconfig.server.json",
    "dev:next": "next dev",
    "dev": "npm run prisma:push && concurrently \"npm:dev:*\"",
    "lint:eslint": "eslint .",
    "build:next": "cross-env NODE_ENV=production next build",
    "build:server": "node bundleServer.mjs",
    "build": "concurrently \"npm:build:*\"",
    "start:next": "next start",
    "start:server": "cross-env NODE_ENV=production \"npm run prisma:push &&  node dist/server/main-production.mjs\"",
    "start": "concurrently \\\"npm:start:*\\\"\""
  },
  "prettier": {
    "singleQuote": false,
    "endOfLine": "auto",
    "printWidth": 100
  },
  "knip": {
    "entry": [
      "src/server/main-*.ts",
      "prisma/seed.ts",
      "src/tests/*.ts"
    ]
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-hook/window-size": "^3.1.1",
    "@tanstack/react-query": "^5.100.8",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "^11.17.0",
    "@trpc/next": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "bcrypt": "^6.0.0",
    "gray-matter": "^4.0.3",
    "next": "16.2.4",
    "pixi.js": "^8.18.1",
    "prisma-json-types-generator": "^5.0.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "sass": "^1.99.0",
    "sharp": "^0.34.5",
    "superjson": "^2.2.6",
    "ws": "^8.20.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.7.1",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-next": "^0.0.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "postcss": "^8.5.13",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  },
  "utilsDependencies": {
    "sharp": "^0.33.2",
    "yargs": "^17.7.2"
  },
  "overrides": {
    "@types/react": "19.2.14"
  }
}