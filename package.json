{
  "type": "module",
  "engines": {
    "node": "^25.0.0"
  },
  "scripts": {
    "db:up": "docker compose up -d -f ./.config/docker-compose.yml",
    "db:destroy": "docker compose down --volumes --remove-orphans -f ./.config/docker-compose.yml",
    "prisma:push": "bunx --bun prisma db push",
    "prisma:seed": "bunx --bun ../prisma/db seed",
    "prisma:reset": "bunx --bun prisma migrate reset",
    "prismagen": "bunx --bun prisma generate",
    "prismagenwatch": "bunx --bun prisma generate --watch",
    "prismastudio": "bunx --bun prisma studio",
    "dev:wss": "cross-env PORT=3001 bun --watch src/server/main-wss-development.ts --tsconfig tsconfig.server.json",
    "dev:next": "next dev",
    "dev": "npm run prisma:push && concurrently \"npm:dev:*\"",
    "build:next": "cross-env NODE_ENV=production next build",
    "build": "concurrently \"npm:build:*\"",
    "start:next": "next start",
    "start:server": "cross-env NODE_ENV=production \"npm run prisma:push &&  node dist/server/main-production.mjs\"",
    "lint": "eslint -c ./.config/eslint.config.ts"
  },
  "prettier": {
    "singleQuote": false,
    "printWidth": 100
  },
  "knip": {
    "entry": [
      "src/server/main-*.ts",
      "prisma/seed.ts",
      "src/tests/*.ts"
    ]
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.100.10",
    "@trpc/client": "^11.17.0",
    "@trpc/next": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@types/yargs": "^17.0.35",
    "@typescript/native-preview": "^7.0.0-dev.20260511.1",
    "bcrypt": "^6.0.0",
    "emittery": "^2.0.0",
    "fallow": "^2.69.0",
    "next": "16.2.6",
    "pixi.js": "^8.18.1",
    "prisma-json-types-generator": "^5.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remark": "^15.0.1",
    "sharp": "^0.34.5",
    "superjson": "^2.2.6",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.7.6",
    "@next/eslint-plugin-next": "^16.2.6",
    "@tanstack/eslint-plugin-query": "^5.100.10",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.6.2",
    "@types/react": "19.2.14",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-de-morgan": "^2.1.2",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "jiti": "^2.7.0",
    "postcss": "^8.5.14",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "utilsDependencies": {
    "sharp": "^0.33.2",
    "yargs": "^17.7.2"
  },
  "overrides": {
    "@types/react": "19.2.14"
  }
}