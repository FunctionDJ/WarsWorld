{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },
  "js/ts.tsserver.experimental.enableProjectDiagnostics": true,
  "js/ts.referencesCodeLens.enabled": true,
  "editor.rulers": [100],
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always"
  },
  "files.associations": {
    "*fallow*.json": "jsonc"
  },
  "prettier.useTabs": true,
  "editor.insertSpaces": false,
  "eslint.options": {
    "overrideConfigFile": ".config/eslint.config.ts"
  },
  "fallow.configPath": ".config/fallow.json",
  "chat.tools.terminal.autoApprove": {
    "/^bunx tsc --noEmit$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^bun lint$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^bunx tsc$/": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "todo-tree.general.tags": ["TODO", "[RO trigger]", "[upstream]"]
}
