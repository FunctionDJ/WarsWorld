{
  "compilerOptions": {
    "target": "esnext",

    "outDir": "dist",
    "lib": ["dom", "dom.iterable", "esnext"],

    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true
  },

  "include": [".", ".eslintrc.cjs"], // .eslintrc.json is extra because the leading period makes it excluded otherwise
  "exclude": ["node_modules", "dist", ".next", "bundleServer.mjs"]
}
