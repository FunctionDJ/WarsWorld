{
  "compilerOptions": {
    "paths": {
      "shared/*": ["./src/shared/*"],
      "*": ["./src/*"]
    },
    "target": "esnext",

    "outDir": "dist",
    "lib": ["dom", "dom.iterable", "esnext"],

    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve"
  },

  "include": ["."],
  "exclude": ["node_modules", "dist", ".next", "bundleServer.mjs"]
}
